{
  "name": "factory-status-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:css": "tailwindcss -i app/static/input.css -o app/static/styles.css --minify",
    "build": "npm run build:css && vite build --configLoader runner",
    "test:ui": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@storybook/html-vite": "10.6.0",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.37",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  },
  "type": "module"
}
